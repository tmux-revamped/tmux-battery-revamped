#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh
set -eu

battery_revamped_self="$0"
case "${battery_revamped_self}" in
*/*) ;;
*) battery_revamped_self="$(command -v -- "${battery_revamped_self}")" ;;
esac
battery_revamped_lib="$(cd "${battery_revamped_self%/*}/../lib" && pwd)" || exit 1

for battery_revamped_inherited in $(env | sed -n -e 's/^\(REVAMPED_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(BATTERY_REVAMPED_[A-Za-z0-9_]*_LOADED\)=.*/\1/p'); do
  case "${battery_revamped_inherited}" in
  REVAMPED_TEST_*) continue ;;
  *) unset "${battery_revamped_inherited}" ;;
  esac
done

REVAMPED_LIB="${battery_revamped_lib}"
# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${REVAMPED_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/battery.sh
. "${REVAMPED_LIB}/battery.sh"

battery_revamped_interface() {
  # shellcheck disable=SC2034
  REVAMPED_UI_NAME=battery-revamped REVAMPED_UI_VERSION="${BATTERY_REVAMPED_VERSION}" REVAMPED_UI_TAGLINE="charge, state and health in the status bar"
  if [ -n "${BATTERY_REVAMPED_ACCENT:-}" ]; then
    # shellcheck disable=SC2034
    REVAMPED_UI_ACCENT_CHOICE="${BATTERY_REVAMPED_ACCENT}" REVAMPED_UI_ACCENT_NAME=BATTERY_REVAMPED_ACCENT
  fi
  # shellcheck source=SCRIPTDIR/../lib/cli.sh
  . "${REVAMPED_LIB}/cli.sh"
  # shellcheck source=SCRIPTDIR/../lib/doctor.sh
  . "${REVAMPED_LIB}/doctor.sh"
}

battery_revamped_usage() {
  battery_revamped_interface
  revamped_cli_usage_error "$1"
}

battery_revamped_bad() {
  battery_revamped_interface
  revamped_cli_die "$1"
}

battery_revamped_help() {
  revamped_cli_help_page <<'HELP'
battery-revamped - battery charge, state and health in the status bar

usage:
  battery-revamped apply        bind the key and fill the placeholders
  battery-revamped list         print what apply would send to tmux
  battery-revamped status NAME  print one placeholder: percentage, icon,
                                icon_charge, icon_status, color_fg, color_bg,
                                color_charge_fg, color_charge_bg,
                                color_status_fg, color_status_bg, graph,
                                remain, charging_watts, cycles, health,
                                drain_rate, estimate, sparkline,
                                power_source or alert_icon
  battery-revamped refresh      read the battery now for the status line
  battery-revamped card         print every figure as a table
  battery-revamped popup        open the battery card in a tmux popup
  battery-revamped popup-card   print the card and wait for a key, what the
                                popup runs
  battery-revamped daemon       publish the placeholders on every tick, for
                                the options render mode
  battery-revamped doctor       check this machine
  battery-revamped version      print the version
  battery-revamped help         print this page

keys:
  --popup-key KEY               the prefix key for the card popup, or off
  --popup-width SIZE            the popup's width
  --popup-height SIZE           the popup's height

reading:
  --interval SECONDS            how long a reading stays fresh, or minute
  --detail-interval SECONDS     how long the remaining time, watts, cycles
                                and health stay fresh
  --render MODE                 jobs or options
  --history-size COUNT          readings kept for the sparkline
  --low-threshold PERCENT       charge that counts as low while discharging
  --critical-threshold PERCENT  charge that counts as critical
  --notify 0|1                  1 sends a desktop notification at low,
                                critical and full charge
  --hide-on-ac 0|1              1 prints every placeholder empty unless the
                                battery is discharging

icons and colours:
  --icons SET                   ascii, or nerd for Nerd Font glyphs
  --charge-tierN-icon TEXT      icon of charge tier N, 1 to 8
  --charge-tierN-fg-color STYLE foreground style of charge tier N
  --charge-tierN-bg-color STYLE background style of charge tier N
  --status-STATE-icon TEXT      icon of charged, charging, discharging,
                                attached or unknown
  --status-STATE-fg-color STYLE foreground style of a state
  --status-STATE-bg-color STYLE background style of a state
  --low-icon TEXT               what alert_icon prints at a low charge
  --critical-icon TEXT          what alert_icon prints at a critical charge
  --source-ac-label TEXT        what power_source prints off the battery
  --source-battery-label TEXT   what power_source prints on the battery
  --before TEXT, --after TEXT   text around percentage; {icon} and {color}
                                stand for the charge icon and tier colour

formats:
  --percentage-format FORMAT    printf format of the charge
  --remain-format FORMAT        printf format of remain and estimate
  --watts-format FORMAT         printf format of the watts
  --cycles-format FORMAT        printf format of the cycle count
  --health-format FORMAT        printf format of the health
  --drain-rate-format FORMAT    printf format of the drain rate
  --graph-width COUNT           cells of the charge bar
  --graph-full TEXT             a filled cell of the bar
  --graph-empty TEXT            an empty cell of the bar
  --METRIC-label TEXT           the label before one metric
  --fixed-width on|off          on pads percentage to its natural width
  --METRIC-width COUNT          the width of one metric

output:
  --json                        list prints one JSON object
  --theme NAME                  the look: kodougu, catppuccin-mocha,
                                catppuccin-latte, dracula, nord, gruvbox,
                                tokyo-night or mono

environment:
  BATTERY_REVAMPED_<SETTING>   the same as the option of that name, such as
                               BATTERY_REVAMPED_INTERVAL for --interval
  BATTERY_REVAMPED_THEME       the look, when --theme is not given
  BATTERY_REVAMPED_ACCENT      a colour such as #CBA6F7 for the accent
  KODOUGU_THEME                the family look, when neither is given
  KODOUGU_ACCENT               the family accent, when the tool's is unset
  NO_COLOR                     turn colour off

tmux options:
  @battery_revamped_popup_key          the card popup key (default M-b)
  @battery_revamped_popup_width        width of the popup (default 44)
  @battery_revamped_popup_height       height of the popup (default 16)
  @battery_revamped_interval           seconds a reading stays fresh
                                       (default 15)
  @battery_revamped_detail_interval    seconds the remaining time, watts,
                                       cycles and health stay fresh
                                       (default 60)
  @battery_revamped_render             jobs or options (default jobs)
  @battery_revamped_history_size       readings kept for the sparkline
                                       (default 16)
  @battery_revamped_low_threshold      percent that is low (default 20)
  @battery_revamped_critical_threshold percent that is critical (default 10)
  @battery_revamped_notify             1 sends notifications (default 0)
  @battery_revamped_hide_on_ac         1 hides everything off the battery
                                       (default 0)
  @battery_revamped_icons              ascii or nerd (default ascii)
  @battery_revamped_charge_tierN_icon  icon of tier N (default one to eight
                                       bars)
  @battery_revamped_charge_tierN_fg_color
  @battery_revamped_charge_tierN_bg_color
                                       style of tier N (default none)
  @battery_revamped_status_STATE_icon  icon of a state (default = + - ! ?)
  @battery_revamped_status_STATE_fg_color
  @battery_revamped_status_STATE_bg_color
                                       style of a state (default none)
  @battery_revamped_low_icon           alert_icon at a low charge (none)
  @battery_revamped_critical_icon      alert_icon at a critical charge (none)
  @battery_revamped_source_ac_label    power_source off the battery (AC)
  @battery_revamped_source_battery_label
                                       power_source on the battery (Bat)
  @battery_revamped_before             text before percentage (none)
  @battery_revamped_after              text after percentage (none)
  @battery_revamped_percentage_format  format of percentage (default "%s%%")
  @battery_revamped_remain_format      format of remain and estimate
                                       (default "%s")
  @battery_revamped_watts_format       format of charging_watts
                                       (default "%sW")
  @battery_revamped_cycles_format      format of cycles (default "%s")
  @battery_revamped_health_format      format of health (default "%s%%")
  @battery_revamped_drain_rate_format  format of drain_rate
                                       (default "%s%%/h")
  @battery_revamped_graph_width        cells of the bar (default 10)
  @battery_revamped_graph_full         filled cell (default a full block)
  @battery_revamped_graph_empty        empty cell (default a light shade)
  @battery_revamped_fixed_width        on or off (default off)
  @battery_revamped_<metric>_label     label before one metric (none)
  @battery_revamped_<metric>_width     width of one metric (none)
  @revamped_theme                      the family look (default kodougu)

notes:
  A metric that takes a label and a width is percentage, graph, remain,
  charging_watts, cycles, health, drain_rate, estimate, sparkline or
  power_source, written with dashes in an option, such as
  --drain-rate-label. The graph width is also the width graph is padded to.
  The placeholders are #{battery_<name>} for each name status takes. Each
  prints the stored reading at once, and starts one background reading
  when it is older than the interval. With --render options each
  placeholder reads a tmux option that a background process fills on every
  tick, so a status refresh starts no process. A tmux option set to
  nothing means its default; an icon, label or text set to off prints
  nothing. A status name that is not a placeholder prints nothing.

examples:
  battery-revamped status percentage
  battery-revamped card
  battery-revamped --icons nerd --fixed-width on apply
  battery-revamped list --json
HELP
}

battery_revamped_show_version() {
  battery_revamped_show_version_tmux=$(tmux -V 2>/dev/null) || battery_revamped_show_version_tmux=missing
  printf '%s %s\n' battery-revamped "${BATTERY_REVAMPED_VERSION}"
  printf 'tmux: %s\n' "${battery_revamped_show_version_tmux#tmux }"
}

battery_revamped_doctor_source() {
  battery_revamped_doctor_source_path=$(command -v "$1" 2>/dev/null) || battery_revamped_doctor_source_path=""
  if [ -n "${battery_revamped_doctor_source_path}" ]; then
    revamped_doctor_line "$1" ok "${battery_revamped_doctor_source_path}, $2"
    return 0
  fi
  revamped_doctor_line "$1" warn "$3"
}

battery_revamped_doctor_macos() {
  battery_revamped_doctor_source pmset "reads the charge, the state and the remaining time" "without it the charge stays empty"
  battery_revamped_doctor_source system_profiler "reads the charger watts" "without it the watts stay empty"
  battery_revamped_doctor_source ioreg "reads the cycle count and the health" "without it the cycles and the health stay empty"
}

battery_revamped_doctor_linux() {
  battery_revamped_dir
  if [ -n "${BATTERY_REVAMPED_DIR}" ]; then
    revamped_doctor_line power_supply ok "${BATTERY_REVAMPED_DIR}, holds the charge, the state, the watts, the cycles and the health"
  else
    revamped_doctor_line power_supply warn "no battery under ${BATTERY_REVAMPED_SYS}/class/power_supply, so the charge falls back to acpi"
  fi
  battery_revamped_doctor_source acpi "reads the charge and the remaining time when no power supply does" "without a power supply or acpi the charge stays empty"
}

battery_revamped_doctor_popup() {
  battery_revamped_popup_check
  case "${BATTERY_REVAMPED_POPUP_OK}" in
  1) revamped_doctor_line popup ok "tmux ${BATTERY_REVAMPED_TMUX} opens the detail popup" ;;
  *) revamped_doctor_line popup warn "the detail popup needs tmux ${BATTERY_REVAMPED_POPUP_SINCE} or later" ;;
  esac
}

battery_revamped_doctor_keys() {
  if [ -n "${BATTERY_REVAMPED_SKIPPED}" ]; then
    revamped_doctor_line keys warn "already bound and left alone: ${BATTERY_REVAMPED_SKIPPED}"
    return 0
  fi
  revamped_doctor_line keys ok "every key it binds is free or its own"
}

battery_revamped_doctor_settings() {
  battery_revamped_doctor_settings_rows=$(battery_revamped_setting_rows)
  # shellcheck disable=SC2154
  revamped_doctor_settings "${BATTERY_REVAMPED_KINDS}" "${battery_revamped_doctor_settings_rows}"
}

battery_revamped_doctor() {
  battery_revamped_plan
  revamped_doctor_tmux
  battery_revamped_doctor_popup
  if revamped_is_macos; then
    battery_revamped_doctor_macos
  else
    battery_revamped_doctor_linux
  fi
  battery_revamped_doctor_settings
  battery_revamped_doctor_keys
  revamped_doctor_gum
  revamped_doctor_notifier
  revamped_doctor_core_tools awk sed tr date cat
  revamped_doctor_finish
  [ "${REVAMPED_DOCTOR_MISSING}" -eq 0 ] || exit 1
}

battery_revamped_list() {
  battery_revamped_plan
  if [ -n "${battery_revamped_json}" ]; then
    battery_revamped_json
    return 0
  fi
  battery_revamped_lines
}

battery_revamped_apply_command() {
  battery_revamped_apply
  battery_revamped_apply_command_sent=$(battery_revamped_bindings)
  case "${battery_revamped_apply_command_sent}" in
  1) printf 'Applied. 1 key is bound.\n' ;;
  *) printf 'Applied. %s keys are bound.\n' "${battery_revamped_apply_command_sent}" ;;
  esac
}

battery_revamped_closing() {
  if [ -z "${BATTERY_REVAMPED_S_percent}" ]; then
    printf '%s. No battery was found on this machine.\n' "$1"
    return 0
  fi
  printf '%s. %s%% charge, %s.\n' "$1" "${BATTERY_REVAMPED_S_percent}" "${BATTERY_REVAMPED_S_status}"
}

battery_revamped_read() {
  battery_revamped_load
  battery_revamped_refresh
}

battery_revamped_refresh_command() {
  battery_revamped_read
  [ "${BATTERY_REVAMPED_STORED}" = 1 ] || battery_revamped_bad "no tmux server is running, so the reading has nowhere to go"
  battery_revamped_closing Refreshed
}

battery_revamped_card_row() {
  BATTERY_REVAMPED_CARD="${BATTERY_REVAMPED_CARD}$1	${2:--}
"
}

battery_revamped_card_figure() {
  battery_revamped_value "$2"
  battery_revamped_card_row "$1" "${BATTERY_REVAMPED_OUT}"
}

battery_revamped_card_rows() {
  BATTERY_REVAMPED_CARD=""
  battery_revamped_card_row Charge "${BATTERY_REVAMPED_S_percent:+${BATTERY_REVAMPED_S_percent}%}"
  battery_revamped_card_row State "${BATTERY_REVAMPED_S_status}"
  battery_revamped_card_figure Remaining remain
  battery_revamped_card_figure Watts charging_watts
  battery_revamped_card_figure "Drain rate" drain_rate
  battery_revamped_card_figure Cycles cycles
  battery_revamped_card_figure Health health
}

battery_revamped_card_load() {
  battery_revamped_load
  revamped_cache_is_number "${BATTERY_REVAMPED_S_percent_ts}" || battery_revamped_refresh
}

battery_revamped_card() {
  battery_revamped_card_load
  if [ -z "${BATTERY_REVAMPED_S_percent}" ]; then
    battery_revamped_card_absent
    return 0
  fi
  battery_revamped_card_rows
  battery_revamped_card_closing=$(battery_revamped_closing Read)
  if revamped_ui_out; then
    printf 'Figure\tValue\n%s' "${BATTERY_REVAMPED_CARD}" | revamped_ui_table
    revamped_ui_done "${battery_revamped_card_closing}"
    return 0
  fi
  printf '%s' "${BATTERY_REVAMPED_CARD}" | awk -F '\t' '{ printf "%-18s %s\n", $1, $2 }'
  printf '%s\n' "${battery_revamped_card_closing}"
}

battery_revamped_card_absent() {
  if revamped_ui_out; then
    revamped_ui_done "No battery was found on this machine."
    return 0
  fi
  printf 'No battery was found on this machine.\n'
}

battery_revamped_wait() {
  [ -t 0 ] || return 0
  battery_revamped_wait_saved=$(stty -g 2>/dev/null) || return 0
  stty -icanon -echo min 1 time 0 2>/dev/null || :
  dd bs=1 count=1 >/dev/null 2>&1 || :
  stty "${battery_revamped_wait_saved}" 2>/dev/null || :
}

battery_revamped_popup_card() {
  battery_revamped_card
  printf 'Press any key to close.'
  battery_revamped_wait
}

battery_revamped_status_command() {
  case " ${BATTERY_REVAMPED_METRICS} " in
  *" ${1:-} "*) battery_revamped_status "$1" ;;
  *) [ -n "${1:-}" ] || battery_revamped_usage "no placeholder given" ;;
  esac
}

battery_revamped_daemon_command() {
  set +e
  battery_revamped_daemon
  battery_revamped_daemon_command_ended=$?
  set -e
  [ "${battery_revamped_daemon_command_ended}" -ne 0 ] || exec "${battery_revamped_self}" daemon
}

battery_revamped_start_menu() {
  revamped_cli_require_terminal
  battery_revamped_start_menu_choice=$(revamped_cli_menu "Show the battery now" "List the bindings" "Apply them now" "Check this machine" "Help")
  case "${battery_revamped_start_menu_choice}" in
  "Show the battery now") battery_revamped_card ;;
  "List the bindings") battery_revamped_list ;;
  "Apply them now") battery_revamped_apply_command ;;
  "Check this machine") battery_revamped_doctor ;;
  *) battery_revamped_help ;;
  esac
}

battery_revamped_dispatch() {
  case "${1:-}" in
  doctor) battery_revamped_doctor ;;
  version | --version | -V) battery_revamped_show_version ;;
  help | --help | -h) battery_revamped_help ;;
  list) battery_revamped_list ;;
  card) battery_revamped_card ;;
  popup-card) battery_revamped_popup_card ;;
  refresh) battery_revamped_refresh_command ;;
  "") battery_revamped_start_menu ;;
  *) revamped_cli_usage_error "unknown command '$1'" ;;
  esac
}

battery_revamped_known() {
  [ "$1" != --theme ] || return 0
  battery_revamped_known_name=$(battery_revamped_setting_name "$1")
  [ -n "${battery_revamped_known_name}" ] || battery_revamped_usage "unknown option '$1'"
}

battery_revamped_set() {
  battery_revamped_set_upper=$(printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]')
  export "BATTERY_REVAMPED_${battery_revamped_set_upper}=$2"
}

battery_revamped_option() {
  battery_revamped_option_name=$(battery_revamped_setting_name "$1")
  [ -n "${battery_revamped_option_name}" ] || battery_revamped_usage "unknown option '$1'"
  battery_revamped_set "${battery_revamped_option_name}" "$2"
}

battery_revamped_check_numbers() {
  battery_revamped_check_numbers_bad=$(env | awk -F '=' '$1 ~ /^BATTERY_REVAMPED_(DETAIL_INTERVAL|GRAPH_WIDTH|HISTORY_SIZE|LOW_THRESHOLD|CRITICAL_THRESHOLD|[A-Z_]+_WIDTH)$/ && $1 != "BATTERY_REVAMPED_FIXED_WIDTH" && $1 != "BATTERY_REVAMPED_POPUP_WIDTH" { value = substr($0, length($1) + 2); if (value != "" && value !~ /^[0-9]+$/) { name = tolower(substr($1, 18)); gsub(/_/, "-", name); if (bad == "") { bad = name "=" value } } } END { if (bad != "") { print bad } }')
  [ -z "${battery_revamped_check_numbers_bad}" ] || battery_revamped_bad "--${battery_revamped_check_numbers_bad%%=*} must be a whole number, got: ${battery_revamped_check_numbers_bad#*=}"
}

battery_revamped_check_interval() {
  case "${BATTERY_REVAMPED_INTERVAL-0}" in
  *[!0-9]*) [ "${BATTERY_REVAMPED_INTERVAL}" = minute ] || battery_revamped_bad "--interval must be a whole number or minute, got: ${BATTERY_REVAMPED_INTERVAL}" ;;
  *) : ;;
  esac
}

battery_revamped_check_choices() {
  case "${BATTERY_REVAMPED_ICONS-ascii}" in
  ascii | nerd) : ;;
  *) battery_revamped_bad "--icons must be ascii or nerd, got: ${BATTERY_REVAMPED_ICONS}" ;;
  esac
  case "${BATTERY_REVAMPED_FIXED_WIDTH-off}" in
  on | off) : ;;
  *) battery_revamped_bad "--fixed-width must be on or off, got: ${BATTERY_REVAMPED_FIXED_WIDTH}" ;;
  esac
  case "${BATTERY_REVAMPED_NOTIFY-0}" in
  0 | 1) : ;;
  *) battery_revamped_bad "--notify must be 0 or 1, got: ${BATTERY_REVAMPED_NOTIFY}" ;;
  esac
  case "${BATTERY_REVAMPED_HIDE_ON_AC-0}" in
  0 | 1) : ;;
  *) battery_revamped_bad "--hide-on-ac must be 0 or 1, got: ${BATTERY_REVAMPED_HIDE_ON_AC}" ;;
  esac
  case "${BATTERY_REVAMPED_RENDER-jobs}" in
  jobs | options) return 0 ;;
  *) battery_revamped_bad "--render must be jobs or options, got: ${BATTERY_REVAMPED_RENDER}" ;;
  esac
}

battery_revamped_check() {
  battery_revamped_check_numbers
  battery_revamped_check_interval
  battery_revamped_check_choices
}

battery_revamped_main() {
  battery_revamped_theme="${BATTERY_REVAMPED_THEME:-}" battery_revamped_json="" battery_revamped_left=$# battery_revamped_rest=0
  while [ "${battery_revamped_left}" -gt 0 ]; do
    battery_revamped_arg="$1"
    shift
    battery_revamped_left=$((battery_revamped_left - 1))
    case "${battery_revamped_rest}:${battery_revamped_arg}" in
    1:*) set -- "$@" "${battery_revamped_arg}" ;;
    0:--) battery_revamped_rest=1 ;;
    0:--json) battery_revamped_json=1 ;;
    0:-h | 0:-V | 0:--help | 0:--version) set -- "$@" "${battery_revamped_arg}" ;;
    0:--theme=*) battery_revamped_theme="${battery_revamped_arg#--theme=}" ;;
    0:--*=*) battery_revamped_option "${battery_revamped_arg%%=*}" "${battery_revamped_arg#*=}" ;;
    0:--*)
      battery_revamped_known "${battery_revamped_arg}"
      [ "${battery_revamped_left}" -gt 0 ] || battery_revamped_usage "option '${battery_revamped_arg}' needs a value"
      if [ "${battery_revamped_arg}" = --theme ]; then
        battery_revamped_theme="$1"
      else
        battery_revamped_option "${battery_revamped_arg}" "$1"
      fi
      shift
      battery_revamped_left=$((battery_revamped_left - 1))
      ;;
    0:-?*) battery_revamped_usage "unknown option '${battery_revamped_arg}'" ;;
    *) set -- "$@" "${battery_revamped_arg}" ;;
    esac
  done
  battery_revamped_check
  battery_revamped_run "${battery_revamped_theme}" "$@"
}

battery_revamped_run() {
  battery_revamped_run_theme="$1"
  shift
  [ -z "${battery_revamped_json}" ] || [ "${1:-}" = list ] || battery_revamped_usage "option '--json' works only with list"
  case "${1:-}" in
  apply) battery_revamped_apply ;;
  status) battery_revamped_status_command "${2:-}" ;;
  popup) battery_revamped_popup ;;
  daemon) battery_revamped_daemon_command ;;
  *)
    battery_revamped_interface
    revamped_cli_start "${battery_revamped_run_theme}"
    battery_revamped_dispatch "$@"
    ;;
  esac
}

battery_revamped_main "$@"
